# --- 数据库与缓存数据 ---
data/

# --- IDE 配置文件 ---
.cursor/
.vscode/
.idea/
.agents/

# --- 构建与临时文件 ---
# 编译生成的二进制文件 (Windows/Linux/Mac)
*.exe
*.exe~
*.dll
*.so
*.dylib
/ChatServer
.gotmp
# 根目录误产出的无扩展名 Linux 二进制（注意锚定根目录，不能裸写 cmd，否则会误伤 apps/*/cmd 源码目录）
/cmd

# --- 日志文件 ---
*.log

# --- 系统文件 ---
.DS_Store
Thumbs.db

# --- Protobuf 生成的文件 ---
# proto 编译生成的 Go 代码（运行 make proto / Docker builder 阶段由 buf 生成，不入库）
*.pb.go
*.pb.validate.go
# 注意：third_party/ 不再整体忽略——third_party/validate/validate.proto 是
# buf generate 的 import 依赖，必须随仓库一起跟踪，否则干净克隆无法生成 pb 代码。

# --- 编译缓存 ---
.gocache/

# --- 前端文件 ---
web/

# --- 部署环境变量文件（保留示例，忽略真实密钥） ---
deploy/env/chatserver.env
deploy/env/*.local
!deploy/env/chatserver.env.example
scripts/__pycache__/gateway_blackbox_test.cpython-312.pyc
