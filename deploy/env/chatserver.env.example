# Copy this file to deploy/env/chatserver.env and replace with your real values.

MYSQL_DSN=root:root@tcp(mysql:3306)/chat_server?charset=utf8mb4&parseTime=True&loc=Local&timeout=5s&readTimeout=10s&writeTimeout=10s
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=chat_server
MYSQL_LOG_LEVEL=warn

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=4
REDIS_MAX_RETRIES=3

KAFKA_BROKERS=kafka:9092
KAFKA_RETRY_TOPIC=redis-retry-queue
KAFKA_RETRY_GROUP_ID=redis-retry-consumer-group
KAFKA_USER_CREATED_TOPIC=user_created
KAFKA_PROFILE_DISPLAY_CHANGED_TOPIC=profile_display_changed
KAFKA_ACCOUNT_DELETED_TOPIC=account.deleted
KAFKA_MSG_PUSH_TOPIC=msg.push
KAFKA_MSG_PUSH_GROUP_ID=message-push-consumer-group
KAFKA_GROUP_CACHE_TOPIC=group.cache
KAFKA_GROUP_CACHE_GROUP_ID=group-cache-projector-group

KAFKA_CONNECT_URL=http://kafka-connect:8083
DEBEZIUM_CONNECTOR_NAME=lcchat-outbox-connector
DEBEZIUM_TOPIC_PREFIX=lcchat
DEBEZIUM_SCHEMA_HISTORY_TOPIC=lcchat.schema-history
DEBEZIUM_MYSQL_HOST=mysql
DEBEZIUM_MYSQL_PORT=3306
DEBEZIUM_MYSQL_USER=debezium
DEBEZIUM_MYSQL_PASSWORD=debezium
DEBEZIUM_MYSQL_DATABASE=chat_server
DEBEZIUM_MYSQL_SERVER_ID=5401
DEBEZIUM_OUTBOX_TABLE=chat_server.outbox_events

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatserver
MINIO_BASE_URL=http://localhost:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_READ=true

# Security
# JWT 签名密钥：auth/gateway/connect 三个服务必须使用【相同】的值。
# 生产环境务必替换为足够随机的长字符串（例如 openssl rand -base64 48）；不设置会回退到不安全的开发默认密钥。
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# 允许跨域携带凭据的来源（逗号分隔）；不设置则使用本地开发白名单。生产环境请显式列出前端域名，不支持 "*"。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8080
# connect WebSocket 握手 Origin 白名单（逗号分隔）：未配置时默认拒绝跨域来源，
# Electron/浏览器渲染进程连接 ws://host:8081 属于跨域，必须列入白名单；本地开发可设为 "*"。
CONNECT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# 网关可信代理（逗号分隔的 IP/CIDR）。位于 nginx/ingress 之后时设为代理所在网段，
# 网关才会信任 X-Real-IP / X-Forwarded-For 解析真实客户端 IP；留空则只用直连地址，忽略这些头（防伪造）。
GATEWAY_TRUSTED_PROXIES=

# Snowflake 节点 ID：每个会调用 GenIDString 的进程必须唯一，取值范围 0-1023。
# docker-compose.yml 内置了本地单副本默认值；若要覆盖 ${AUTH_SNOWFLAKE_NODE_ID} 这类
# Compose 插值变量，请放在 shell 环境或项目根 .env，而不是只放在这个 env_file。
# 如果未来要横向扩容这些服务，需要为每个副本分配不同节点号，不能共享同一个值。
AUTH_SNOWFLAKE_NODE_ID=101
USER_SNOWFLAKE_NODE_ID=201
GROUP_SNOWFLAKE_NODE_ID=301
MSG_SNOWFLAKE_NODE_ID=401

GIN_MODE=release
AUTH_SERVICE_ADDR=auth:9090
USER_SERVICE_ADDR=user:9094
RELATION_SERVICE_ADDR=relation:9093
GROUP_SERVICE_ADDR=group:9095
MSG_SERVICE_ADDR=msg:9092
GATEWAY_ADDR=:8080

AUTH_GRPC_ADDR=:9090
AUTH_METRICS_ADDR=:9190
USER_GRPC_ADDR=:9094
USER_METRICS_ADDR=:9194
RELATION_GRPC_ADDR=:9093
RELATION_METRICS_ADDR=:9193
GROUP_GRPC_ADDR=:9095
GROUP_METRICS_ADDR=:9195
MSG_GRPC_ADDR=:9092
MSG_METRICS_ADDR=:9192
CONNECT_ADDR=:8081
CONNECT_GRPC_ADDR=:9091
CONNECT_SELF_GRPC_ADDR=connect:9091
MESSAGE_PUSH_HTTP_ADDR=:8084

MESSAGE_PUSH_ROUTE_TTL_SECONDS=180
MESSAGE_PUSH_CONNECT_TIMEOUT_USER_MS=150
MESSAGE_PUSH_MAX_FANOUT_CONCURRENCY=32

# Verify code email (QQ SMTP)
EMAIL_SENDER=2315635418@qq.com
EMAIL_SENDER_NAME=LCChat
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_AUTH_CODE=CHANGE_ME_QQ_SMTP_AUTH_CODE
