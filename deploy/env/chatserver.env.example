# 复制为 deploy/env/chatserver.env 后按需修改（chatserver.env 已被 .gitignore 忽略，勿提交密钥）。
# docker-compose 内：gateway 连接 auth:9090 / user:9094 / relation:9093 / msg:9092；
# connect 使用 AUTH_GRPC_ADDR 连接 auth:9090；message-push / msg 使用 USER_GRPC_ADDR 连接 user:9094。

MYSQL_DSN=root:root@tcp(mysql:3306)/chat_server?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=chat_server
MYSQL_LOG_LEVEL=warn

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=4
REDIS_MAX_RETRIES=3

KAFKA_BROKERS=kafka:9092
KAFKA_RETRY_TOPIC=redis-retry-queue
KAFKA_RETRY_GROUP_ID=redis-retry-consumer-group

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=chatserver
MINIO_BASE_URL=http://localhost:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_READ=true

GIN_MODE=release
AUTH_SERVICE_ADDR=auth:9090
USER_SERVICE_ADDR=user:9094
RELATION_SERVICE_ADDR=relation:9093
MSG_SERVICE_ADDR=msg:9092
GATEWAY_ADDR=:8080
# 仅作本地/非 compose 参考；compose 中由各服务 environment 覆盖
AUTH_GRPC_ADDR=:9090
AUTH_METRICS_ADDR=:9190
USER_GRPC_ADDR=:9094
USER_METRICS_ADDR=:9194
RELATION_GRPC_ADDR=:9093
RELATION_METRICS_ADDR=:9193
MSG_GRPC_ADDR=:9092
MSG_METRICS_ADDR=:9192

# Connect：HTTP(WebSocket) 与对内 gRPC（宿主机映射见 docker-compose 中 CONNECT_HTTP_PORT / CONNECT_GRPC_PORT）
CONNECT_ADDR=:8081
CONNECT_GRPC_ADDR=:9091

# Verify code email (QQ SMTP)
EMAIL_SENDER=2315635418@qq.com
EMAIL_SENDER_NAME=LCChat
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_AUTH_CODE=CHANGE_ME_QQ_SMTP_AUTH_CODE
